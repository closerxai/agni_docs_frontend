build-knowledge.js
postbuild.js
add-language-examples.js

# Disabled custom playground/SDK (using Mintlify built-in)
agni-playground.js
agni-playground.css
agni-sdk.js
agni-sdk.css

# API directory (serverless functions, not docs)
api/
